# SerpApi key: https://serpapi.com/manage-api-key
# Leave empty to run in replay mode against the recorded demo scans.
SERPAPI_API_KEY=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Max SerpApi searches a single scan may spend (cache hits are free).
SCAN_SEARCH_BUDGET=15
